# External health watchdog for the bridge — runs on watchdog.timer, pings
# Telegram if the bridge is down/wedged/unauthed. Install alongside the bridge:
#   cp systemd/watchdog.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now watchdog.timer
#
# Deliberately a separate unit from the bridge so it survives the bridge dying.

[Unit]
Description=Teams<->Telegram bridge health watchdog

[Service]
Type=oneshot
# Point at your checkout. ENV_FILE defaults to <repo>/.env (bot token + group id).
ExecStart=%h/teams-telegram-bridge/tools/watchdog.sh
# teams-cli lives in ~/.local/bin; keep it on PATH for the auth check.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# How often it repeats itself. Uncomment to change:
#   BEAT_OK_SEC  — "still up" heartbeat while healthy (default 86400 = daily)
#   BEAT_BAD_SEC — re-alert interval while broken   (default 21600 = 6h)
# Set BEAT_OK_SEC very high to get alerts only, but then silence is ambiguous
# again — that's what let the 2026-08-03 outage run for 10 days.
#Environment=BEAT_OK_SEC=86400
#Environment=BEAT_BAD_SEC=21600
