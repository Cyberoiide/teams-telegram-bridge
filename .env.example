# Copy to .env and fill in. Never commit .env (it's gitignored).

# --- Telegram (from @BotFather) ---
# Create a bot: message @BotFather -> /newbot -> copy the token.
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...

# The supergroup (Topics enabled) where chats are mirrored. The bot must be an
# admin with "Manage Topics". Get the id by sending a message in the group then
# calling getUpdates, or run: python3 tools/get_group_id.py
TELEGRAM_GROUP_ID=-1001234567890

# --- Teams ---
# Region for the IC3 chat service: emea | amer | apac
TEAMS_REGION=emea

# --- Behavior (optional) ---
# Forward your OWN sent Teams messages too (so the full convo is readable from
# Telegram/phone). 1 = on (default), 0 = off.
ECHO_SELF=1

# Poll interval (seconds) for new Teams messages.
POLL_SEC=5

# Token re-mint interval (seconds). Teams tokens last ~24h; default 20h.
REFRESH_SEC=72000

# --- Display (for headless token minting via Playwright) ---
# The X display the intune-container + Playwright use. Set up by the enroll step.
DISPLAY=:99
